PORT=3001
NODE_ENV=development

# Supabase (Client-Safe / Public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative supported aliases:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Supabase (Server-Only Secret - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# AI & Weather Providers (Server-Only Secrets - NEVER expose to browser)
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Zero-Accidental-Quota Gemini Gate (Default false - real Gemini calls strictly disabled)
LIVE_GEMINI_TEST=false

# Google OAuth (Optional / Client-Safe)
# Configured in Supabase Dashboard > Authentication > Providers > Google
# Optional client ID for direct Google Identity Services:
VITE_GOOGLE_CLIENT_ID=
